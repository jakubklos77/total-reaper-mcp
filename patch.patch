-            if src_bpm_response.get("value", 0) > 0:
-                detected_tempo = src_bpm_response.get("value")
-    
-    return {
-        "success": detect_response.get("result", False),
-        "detected_tempo": detected_tempo,
-        "items_analyzed": item_count
